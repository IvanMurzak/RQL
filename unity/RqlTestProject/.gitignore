# Unity crash / build artefacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa/*

# MCP / AI-client files generated into the project by Unity-MCP and the AI Game Dev App
# (the plugin's own config lives in UserSettings/, ignored above)
.mcp.json
.claude/
.codex/
.cursor/
.gemini/
.agent/
.github/skills/
opencode.json
kernelsCache/

# OS noise
.DS_Store
