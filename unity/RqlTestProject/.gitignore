# Unity-generated folders (rebuilt on open)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# NuGet DLLs restored automatically by Unity-MCP's dependency resolver
/[Aa]ssets/[Pp]lugins/NuGet/
/[Aa]ssets/[Pp]lugins/NuGet.meta

# Package lock (regenerated by the Package Manager)
/[Pp]ackages/packages-lock.json

# IDE / generated project files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
