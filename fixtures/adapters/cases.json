{
  "version": "0.1",
  "description": "Golden vectors for spec §13 type adapters. 'plan'/'expect' generated by the .NET reference (Rql.Conformance regen) and reviewed.",
  "adapters": {
    "description": "Test adapters every runtime registers (in its conformance harness) on a fresh engine over fixtures/cross-runtime/graph.json. Behaviour, not code, is specified here.",
    "Vec2": {
      "encode": "string \"(x, y)\" using shortest round-trip numbers, e.g. {x:2.25,y:3} -> \"(2.25, 3)\"",
      "coerce": "from a string \"(x, y)\" (optional spaces) or a list [x, y] of two numbers; anything else fails with reason \"expected (x, y) or [x, y]\"",
      "compare": "equality: both values coerced to Vec2, equal when |dx| <= 1e-9 and |dy| <= 1e-9; ordering: by length sqrt(x*x+y*y)",
      "members": "virtual read-only member `len` (number) = sqrt(x*x+y*y)",
      "describe": "Vec2: write as \"(x, y)\" or [x, y]"
    },
    "Node": {
      "members": "virtual member `childCount` (int, read-only) = Children count; virtual writable member `title` (string): get = Name upper-cased (ASCII), set = Name := value lower-cased (ASCII); validation rejects an empty string with reason \"title must not be empty\" (before any write); the setter itself THROWS \"node 3 is locked\" when the node's Id is 3 (exercises rollback); member `Note` is HIDDEN; member `Children` is EXPLICIT-ONLY (generic recurse does not follow it)",
      "describe": "Node: a conformance graph node"
    },
    "Special": {
      "members": "virtual read-only member `powerLevel` (number) = Power / 1000 (applies IN ADDITION to the Node adapter: composition)"
    }
  },
