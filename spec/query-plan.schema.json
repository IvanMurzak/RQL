{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rql.dev/schema/0.1/query-plan.json",
  "title": "RQL QueryPlan v0.1",
  "description": "Language- and transport-neutral intermediate representation of an RQL query. Canonical form: optional fields at their default are omitted; object key order is not significant.",
  "type": "object",
  "required": ["rql", "source", "stages"],
  "additionalProperties": false,
  "properties": {
    "rql": { "const": "0.1" },
    "source": { "$ref": "#/$defs/expr" },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } }
  },
  "$defs": {
    "expr": {
      "oneOf": [
        { "$ref": "#/$defs/lit" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/object" },
        { "$ref": "#/$defs/path" },
        { "$ref": "#/$defs/op" },
        { "$ref": "#/$defs/call" }
      ]
    },
    "lit": {
      "type": "object", "required": ["lit"], "additionalProperties": false,
      "properties": { "lit": { "type": ["null", "boolean", "number", "string"] } }
    },
    "list": {
      "type": "object", "required": ["list"], "additionalProperties": false,
      "properties": { "list": { "type": "array", "items": { "$ref": "#/$defs/expr" } } }
    },
    "object": {
      "description": "Object literal (semantics §4.5): ordered entries with unique non-empty keys.",
      "type": "object", "required": ["object"], "additionalProperties": false,
      "properties": { "object": { "type": "array", "items": { "type": "object", "required": ["key", "value"], "additionalProperties": false, "properties": { "key": { "type": "string", "minLength": 1 }, "value": { "$ref": "#/$defs/expr" } } } } }
    },
    "path": {
      "description": "Navigation from the current item ($), or from 'on' when present. An empty path is $ itself.",
      "type": "object", "required": ["path"], "additionalProperties": false,
      "properties": {
        "path": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
        "on": { "$ref": "#/$defs/expr" }
      }
    },
    "segment": {
      "oneOf": [
        { "type": "string", "minLength": 1, "description": "member name" },
        { "type": "object", "required": ["index"], "additionalProperties": false, "properties": { "index": { "type": "integer" } } },
        { "type": "object", "required": ["key"], "additionalProperties": false, "properties": { "key": { "type": ["string", "number"] } } },
        { "type": "object", "required": ["meta"], "additionalProperties": false, "properties": { "meta": { "type": "string", "minLength": 1 } } }
      ]
    },
    "op": {
      "type": "object", "required": ["op", "args"], "additionalProperties": false,
      "properties": {
        "op": { "enum": ["or", "and", "not", "==", "!=", "<", "<=", ">", ">=", "contains", "starts-with", "ends-with", "matches", "in", "is", "neg", "+", "-", "*", "/", "%", "index"] },
        "args": { "type": "array", "items": { "$ref": "#/$defs/expr" }, "minItems": 1, "maxItems": 2 }
      }
    },
    "call": {
      "description": "Function call (no 'on') or method call on the value of 'on'. Arguments of collection methods are evaluated per element.",
      "type": "object", "required": ["call", "args"], "additionalProperties": false,
      "properties": {
        "call": { "type": "string", "minLength": 1 },
        "on": { "$ref": "#/$defs/expr" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } }
      }
    },
    "stage": {
      "type": "object", "required": ["op"],
      "properties": { "op": { "type": "string", "minLength": 1 } },
      "allOf": [
        { "if": { "properties": { "op": { "const": "where" } } }, "then": { "required": ["pred"], "properties": { "op": true, "pred": { "$ref": "#/$defs/expr" } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "const": "select" } } }, "then": { "required": ["fields"], "properties": { "op": true, "fields": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "expr"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "expr": { "$ref": "#/$defs/expr" } } } } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "const": "sort" } } }, "then": { "required": ["keys"], "properties": { "op": true, "keys": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["expr"], "additionalProperties": false, "properties": { "expr": { "$ref": "#/$defs/expr" }, "desc": { "const": true } } } } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "enum": ["first", "skip"] } } }, "then": { "required": ["n"], "properties": { "op": true, "n": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "enum": ["count", "describe"] } } }, "then": { "properties": { "op": true }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "enum": ["get", "sum", "min", "max", "avg", "group-by"] } } }, "then": { "required": ["expr"], "properties": { "op": true, "expr": { "$ref": "#/$defs/expr" } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "const": "distinct" } } }, "then": { "properties": { "op": true, "expr": { "$ref": "#/$defs/expr" } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "const": "recurse" } } }, "then": { "properties": { "op": true, "via": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expr" } }, "maxDepth": { "type": "integer", "minimum": 1 }, "includeSelf": { "const": false, "description": "default true: the input items are emitted (depth 0) before their descendants" } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "const": "set" } } }, "then": { "required": ["assign"], "properties": { "op": true, "assign": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["target", "value"], "additionalProperties": false, "properties": { "target": { "$ref": "#/$defs/path" }, "value": { "$ref": "#/$defs/expr" } } } } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "const": "call" } } }, "then": { "required": ["method", "args"], "properties": { "op": true, "method": { "type": "string", "minLength": 1 }, "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } } }, "additionalProperties": false } },
        { "if": { "properties": { "op": { "not": { "enum": ["where", "select", "sort", "first", "skip", "count", "describe", "get", "sum", "min", "max", "avg", "group-by", "distinct", "recurse", "set", "call"] } } } }, "then": { "properties": { "op": { "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)+$" }, "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } }, "named": { "type": "object", "additionalProperties": { "$ref": "#/$defs/expr" } } }, "additionalProperties": false } }
      ]
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxVisited": { "type": "integer", "minimum": 1 },
        "maxRows": { "type": "integer", "minimum": 0 },
        "maxListItems": { "type": "integer", "minimum": 0 },
        "maxDepth": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 64 },
        "maxMutationTargets": { "type": "integer", "minimum": 0 }
      }
    },
    "request": {
      "description": "Transport envelope (IPC/tool). Exactly one of 'plan' or 'text'.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "rql": { "const": "0.1" },
        "plan": { "$ref": "#" },
        "text": { "type": "string" },
        "budgets": { "$ref": "#/$defs/budgets" },
        "options": { "type": "object", "additionalProperties": false, "properties": { "dryRun": { "type": "boolean" }, "allowMutation": { "type": "boolean" } } }
      }
    }
  }
}
